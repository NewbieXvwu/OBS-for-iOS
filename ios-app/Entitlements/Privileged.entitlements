<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.temporary-exception.mach-register.global-name</key>
	<array>
		<string>com.obsproject.ios.screen.mach</string>
	</array>
	<key>com.apple.multitasking.systemappassertions</key>
	<true/>
	<key>com.apple.private.memorystatus</key>
	<true/>
	<key>com.apple.developer.background-tasks.continued-processing.gpu</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.org.obsproject.studio.ios</string>
	</array>
</dict>
</plist>
